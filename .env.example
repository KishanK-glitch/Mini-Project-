# Copy to .env and adjust. Everything here is optional.

# Config file (default: config/default.yaml)
# VR_CONFIG=config/default.yaml

# Metadata DB. SQLite is the default; for PostgreSQL run `docker compose up -d postgres`
# DATABASE_URL=sqlite:///data/metadata.db
# DATABASE_URL=postgresql+psycopg2://vr_user:vr_password@localhost:5432/video_retrieval

# Override any config value:  VR__<SECTION>__<KEY>
# VR__EMBEDDING__DEVICE=cuda
# VR__DETECTION__MODEL=yolov8s.pt
# VR__INGESTION__FRAME_STRIDE=3

# docker-compose.yml (PostgreSQL container)
POSTGRES_USER=vr_user
POSTGRES_PASSWORD=vr_password
POSTGRES_DB=video_retrieval
POSTGRES_PORT=5432
